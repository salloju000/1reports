<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>1Reports.Crystal</AssemblyName>
    <RootNamespace>OneReports.Crystal</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="CrystalDecisions.CrystalReports.Engine" HintPath="$(CrystalSdkDir)\CrystalDecisions.CrystalReports.Engine.dll" />
    <Reference Include="CrystalDecisions.Shared" HintPath="$(CrystalSdkDir)\CrystalDecisions.Shared.dll" />
    <Reference Include="CrystalDecisions.ReportAppServer.ClientDoc" HintPath="$(CrystalSdkDir)\CrystalDecisions.ReportAppServer.ClientDoc.dll" />
    <Reference Include="CrystalDecisions.ReportAppServer.DataDefModel" HintPath="$(CrystalSdkDir)\CrystalDecisions.ReportAppServer.DataDefModel.dll" />
    <Reference Include="CrystalDecisions.ReportAppServer.Controllers" HintPath="$(CrystalSdkDir)\CrystalDecisions.ReportAppServer.Controllers.dll" />
  </ItemGroup>
  <Target Name="CheckCrystalSdk" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(CrystalSdkDir)\CrystalDecisions.CrystalReports.Engine.dll')"
           Text="Set CrystalSdkDir to the installed SAP Crystal Reports for Visual Studio SDK assemblies." />
  </Target>
</Project>
